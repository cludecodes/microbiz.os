# =============================================================================
# MicroBiz OS - Environment template
# Copy to apps/web/.env.local for frontend values.
# NEVER put real credentials in this file or in committed files.
# All secret credentials live ONLY in Cloudflare Worker secrets
# (wrangler secret put ...) or local-only .dev.vars files (gitignored).
# =============================================================================

# --- Frontend (apps/web/.env.local) ---
# Public URL the API is served from. In local dev the Vite proxy handles /api.
# VITE_API_URL=https://api.microbiz.example
