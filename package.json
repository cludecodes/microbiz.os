{
  "name": "microbiz-os",
  "version": "0.1.0",
  "private": true,
  "description": "MicroBiz OS - multi-tenant SaaS platform built on Cloudflare Workers + D1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev -w @microbiz/web",
    "dev:api": "npm run dev -w @microbiz/api",
    "db:migrate:local": "npm run db:migrate:local -w @microbiz/api",
    "db:seed:local": "npm run db:seed:local -w @microbiz/api",
    "db:setup": "npm run db:migrate:local && npm run db:seed:local"
  }
}
